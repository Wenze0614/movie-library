# Optional. Lets "Add film" search TMDB and auto-fill poster, story, cast, etc.
# Get a free key at https://www.themoviedb.org/settings/api
# Either the v3 "API Key" or the v4 "API Read Access Token" works here.
TMDB_API_KEY=

# Optional. Where your library lives. Defaults to ./data
# CINEMA_DATA_DIR=/absolute/path/to/my-movie-library
