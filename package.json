{
  "name": "movie-library",
  "version": "0.1.0",
  "private": true,
  "description": "A cozy, local-first movie library with a 3D windowsill scene.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "postinstall": "node -e \"require('fs').mkdirSync('public/rive',{recursive:true});require('fs').copyFileSync('node_modules/@rive-app/canvas/rive.wasm','public/rive/rive.wasm')\"",
    "cat": "cd art/rive-cat && python3 generate.py && rive . --once && cp build/cat.riv ../../public/rive/cat.riv",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop": "npm run desktop:build && electron .",
    "dist:mac": "node scripts/package-desktop.mjs --mac",
    "dist:win": "node scripts/package-desktop.mjs --win"
  },
  "dependencies": {
    "@rive-app/canvas": "^2.45.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.3"
  },
  "main": "electron/main.mjs",
  "author": "Wenze Zhang",
  "build": {
    "appId": "com.wz314.movielibrary",
    "productName": "Movie Library",
    "copyright": "Copyright © 2026 Wenze Zhang",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "seed/movies",
        "to": "seed"
      }
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Movie Library uses System Events to set your desktop wallpaper to a film's backdrop."
      },
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Movie-Library-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Movie-Library-windows-${arch}-setup.${ext}"
    },
    "afterPack": "scripts/after-pack.cjs",
    "publish": null
  },
  "license": "CC0-1.0"
}
